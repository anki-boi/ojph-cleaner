{
  "manifest_version": 3,
  "name": "OJ.ph Cleaner",
  "version": "0.7.0",
  "description": "Hides stale, no-salary and keyword-matching jobs on OnlineJobs.ph, highlights the ones you want, and shows what it hid",
  "permissions": ["storage"],
  "host_permissions": ["https://www.onlinejobs.ph/*", "https://onlinejobs.ph/*"],
  "content_scripts": [
    {
      "matches": ["https://www.onlinejobs.ph/*", "https://onlinejobs.ph/*"],
      "js": ["rules.js", "content.js", "salary.js", "salary-cards.js", "pagination.js", "panel.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
