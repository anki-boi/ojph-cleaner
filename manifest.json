{
  "manifest_version": 3,
  "name": "OJ.ph Cleaner",
  "version": "0.21.1",
  "description": "See every OnlineJobs.ph job's real hourly rate, hide stale, unpaid and unwanted posts, and flag lowball offers to report",
  "permissions": ["storage"],
  "host_permissions": ["https://www.onlinejobs.ph/*", "https://onlinejobs.ph/*",
                    "http://127.0.0.1:8371/*", "http://127.0.0.1:8372/*"],
  "content_scripts": [
    {
      "matches": ["https://www.onlinejobs.ph/*", "https://onlinejobs.ph/*"],
      "js": [
        "labels.js", "rules.js", "tiers.js", "page.js", "detail-text.js", "closed.js", "detail-parse.js", "detail-cache.js",
        "records.js", "toast.js", "chip.js", "content.js", "observer.js", "salary.js", "per-hour.js", "salary-cards.js",
        "closed-cards.js", "records-store.js", "records-cards.js", "export.js", "pagination.js", "scan.js", "pay-sort.js",
        "dashboard-fit.js", "dashboard-cards.js", "presets.js", "panel.js", "setup.js", "myjobs.js", "suggest.js", "visits.js", "triage.js", "lowball.js", "lowball-cards.js","swipe.js", "risk.js", "schedule.js", "trust.js", "glance.js", "glance-cards.js", "compare.js", "searches.js", "detail.js", "detail-actions.js",
        "apply-ask.js", "backup-file.js", "backup.js",
        "resume-read.js", "resume-pdf.js", "resume-words.js", "skill-tags.js", "resume-ui.js"
      ],
      "css": ["ui.css", "content.css", "triage.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["jobs.html", "options.html"], "matches": ["https://www.onlinejobs.ph/*", "https://onlinejobs.ph/*"] }
  ],
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
